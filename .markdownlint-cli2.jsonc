{
  "$schema": "https://raw.githubusercontent.com/DavidAnson/markdownlint-cli2/main/schema/markdownlint-cli2-config-schema.json",
  "config": {
    "default": true,
    "MD013": false,   // line length (let formatter handle)
    "MD024": false,   // allow duplicate headings
    "MD033": false,   // inline HTML is fine in documentation
    "MD041": false    // first heading can be level 1
  },
  "include": ["**/*.md"],
  "exclude": ["node_modules/**", ".git/**"]
}
