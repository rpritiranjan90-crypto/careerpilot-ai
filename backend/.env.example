# ============================================================
# CareerPilot AI – Backend Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# PRODUCTION: Use a secrets manager (AWS SSM, Vault, Doppler, …)
# NEVER commit .env to version control.
# ============================================================

# ------------------------------------------------------------
# APPLICATION
# ------------------------------------------------------------
APP_NAME=CareerPilot AI
ENVIRONMENT=development
DEBUG=true
# Set DEBUG=false in production
# Set ENVIRONMENT=production to enable structured JSON logs

# ------------------------------------------------------------
# CORS – comma-separated list of allowed origins
# ------------------------------------------------------------
# Development: allow the Vite dev server
CORS_ORIGINS=http://localhost:3000
# Production example: CORS_ORIGINS=https://careerpilot.example.com

# ------------------------------------------------------------
# SUPABASE (Database + Auth)
# ------------------------------------------------------------
# Get these from your Supabase project settings → API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# JWT secret from Supabase dashboard → Project Settings → API → JWT Secret
# Required for real authentication. Get it from your Supabase project.
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ------------------------------------------------------------
# DATABASE (Alternative to Supabase)
# ------------------------------------------------------------
# Uncomment and fill in to use a local/custom PostgreSQL instance
# DATABASE_URL=postgresql://postgres:password@localhost:5432/careerpilot

# ------------------------------------------------------------
# OLLAMA (Local AI – Free, privacy-preserving)
# ------------------------------------------------------------
# Install: https://ollama.ai
# Pull model: ollama pull llama3.2:3b
# Start: ollama serve (runs on port 11434 by default)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

# ------------------------------------------------------------
# GROQ CLOUD AI (Free tier – https://console.groq.com)
# ------------------------------------------------------------
# Groq is used in preference to Ollama when GROQ_API_KEY is set.
# Free tier: ~30 req/min. No credit card required.
# Get your key from: https://console.groq.com/keys
# GROQ_API_KEY=your_key_here
# GROQ_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------
# FILE UPLOADS
# ------------------------------------------------------------
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf,docx,txt

# ------------------------------------------------------------
# RATE LIMITS (requests per hour per user)
# ------------------------------------------------------------
RATE_LIMIT_ANALYZE=20
RATE_LIMIT_INTERVIEW=30

# ------------------------------------------------------------
# LOGGING
# ------------------------------------------------------------
# Set to DEBUG for verbose output (development only)
# LOG_LEVEL=INFO   # development
# LOG_LEVEL=DEBUG  # verbose debugging

# ------------------------------------------------------------
# SECURITY
# ------------------------------------------------------------
# Set to true only in local development when you don't have a Supabase project.
# NEVER set this in production — it accepts any Bearer token as the user_id.
DEV_TOKEN_AUTH=false
