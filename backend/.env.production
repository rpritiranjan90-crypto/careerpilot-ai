# ============================================================
# Production environment overrides
# ============================================================
# Copy this to .env when deploying to production, then set real values.
# DO NOT commit this file to version control.
# ============================================================

APP_NAME=CareerPilot AI
ENVIRONMENT=production
DEBUG=false
LOG_LEVEL=INFO

# Production CORS – list your exact domain(s), no wildcards
CORS_ORIGINS=https://careerpilot.example.com,https://www.careerpilot.example.com

# Supabase – fill from your Supabase project production settings
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-production-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-production-service-role-key

# Ollama – set to your internal Ollama endpoint or remove
OLLAMA_BASE_URL=http://ollama-internal:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=120

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=5
ALLOWED_EXTENSIONS=pdf,docx,txt

RATE_LIMIT_ANALYZE=20
RATE_LIMIT_INTERVIEW=30
