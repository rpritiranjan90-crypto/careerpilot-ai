# Lint rules shared across all Dockerfiles
# See: https://github.com/hadolint/hadolint#configuration
{
  "ignore": [
    "DL3008",  # pin versions in apt-get (not critical for base images)
    "DL3015",  # avoid latest apt-get upgrade (fine in slim base images)
    "SC2086"   # shellcheck: quote with double quotes for safety
  ]
}
